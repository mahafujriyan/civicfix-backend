{
  "version": 2,
  "buildCommand": "prisma generate",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{src/docs/openapi.yaml,prisma/**}"
    }
  }
}
